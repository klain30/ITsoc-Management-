# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Matches docker-compose.yml (host port 5433)
DATABASE_URL="postgresql://itsoc:itsoc_dev_password@localhost:5433/itsoc_management?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-string-of-at-least-32-chars"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed browser origins
CORS_ORIGINS="http://localhost:5173"
# Public URL of the frontend; used in QR codes, invitation links and certificates
APP_URL="http://localhost:5173"
# Set to 1 when running behind a reverse proxy (nginx, Render, etc.)
TRUST_PROXY=0

UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5
APP_TIMEZONE="Asia/Manila"
