// ITSoc Management System — database schema.
// Design notes live in docs/database.md. Things Prisma cannot express
// (partial unique indexes, append-only triggers) are added by hand in the
// migrations and documented there.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum RoleName {
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY
  TREASURER
  AUDITOR
  MEMBER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum AccountTokenType {
  INVITATION
  PASSWORD_RESET
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  ALUMNI
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum AttendanceSource {
  QR
  MANUAL
  SYSTEM
}

enum BudgetStatus {
  ACTIVE
  CLOSED
}

enum ExpenseCategory {
  FOOD
  DECORATIONS
  MATERIALS
  PRINTING
  PRIZES
  TRANSPORTATION
  VENUE
  HONORARIUM
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

enum DocumentCategory {
  EVENT_PROPOSAL
  MEETING_MINUTES
  FINANCIAL_REPORT
  ACCOMPLISHMENT_REPORT
  ORGANIZATION_DOCUMENT
  OTHER
}

enum DocumentVisibility {
  OFFICERS
  MEMBERS
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  EVENT_REGISTRATION_CONFIRMED
  EVENT_REMINDER
  EVENT_CANCELLED
  CERTIFICATE_AVAILABLE
  ANNOUNCEMENT_PUBLISHED
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  EXPENSE_REIMBURSED
}

// ─────────────────────────────────────────────────────────────
// Organization profile (single row — the system is single-tenant)
// ─────────────────────────────────────────────────────────────

model Organization {
  id         Int      @id @default(1)
  name       String
  shortName  String
  university String
  email      String?
  updatedAt  DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Identity & access
// ─────────────────────────────────────────────────────────────

/// Login account. Every account belongs to exactly one member profile;
/// the email address lives on Member so there is one source of truth.
model User {
  id                  String     @id @default(cuid())
  memberId            String     @unique
  passwordHash        String?
  status              UserStatus @default(INVITED)
  roleId              String
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  refreshTokens        RefreshToken[]
  accountTokens        AccountToken[]         @relation("AccountTokenUser")
  issuedAccountTokens  AccountToken[]         @relation("AccountTokenIssuer")
  notifications        Notification[]
  auditLogs            AuditLog[]
  positionAssignments  PositionAssignment[]   @relation("PositionAssignedBy")
  createdEvents        Event[]                @relation("EventCreatedBy")
  attendanceSessions   AttendanceSession[]    @relation("AttendanceSessionCreatedBy")
  recordedAttendance   Attendance[]           @relation("AttendanceRecordedBy")
  issuedCertificates   Certificate[]          @relation("CertificateIssuedBy")
  createdBudgets       Budget[]               @relation("BudgetCreatedBy")
  createdExpenses      Expense[]              @relation("ExpenseCreatedBy")
  reviewedExpenses     Expense[]              @relation("ExpenseReviewedBy")
  expenseStatusChanges ExpenseStatusChange[]
  uploadedReceipts     Receipt[]
  uploadedDocuments    Document[]             @relation("DocumentUploadedBy")
  deletedDocuments     Document[]             @relation("DocumentDeletedBy")
  announcements        Announcement[]

  @@index([roleId])
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  description String
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// Opaque refresh tokens, stored hashed. Tokens issued from one login share
/// a familyId so reuse of a rotated token can revoke the whole family.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Single-use tokens for account invitations and officer-issued password resets.
model AccountToken {
  id          String           @id @default(cuid())
  userId      String
  type        AccountTokenType
  tokenHash   String           @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime         @default(now())

  user      User  @relation("AccountTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AccountTokenIssuer", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, type])
}

// ─────────────────────────────────────────────────────────────
// Members & officers
// ─────────────────────────────────────────────────────────────

model Member {
  id              String           @id @default(cuid())
  studentId       String           @unique
  firstName       String
  middleName      String?
  lastName        String
  email           String           @unique
  course          String
  yearLevel       Int
  section         String?
  contactNumber   String?
  profileImageKey String?
  status          MembershipStatus @default(ACTIVE)
  dateJoined      DateTime         @default(now()) @db.Date
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user                User?
  positionAssignments PositionAssignment[]
  registrations       EventRegistration[]
  attendance          Attendance[]
  certificates        Certificate[]
  paidExpenses        Expense[]            @relation("ExpensePaidBy")

  @@index([status])
  @@index([lastName, firstName])
}

/// Officer titles are data, not code: officers can add "Committee Head",
/// "PRO", etc. without a migration. Positions are separate from RBAC roles.
model Position {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments PositionAssignment[]
}

/// Officer term history. An open assignment (endDate IS NULL) is the
/// member's current position; a partial unique index (see migration) allows
/// at most one open assignment per member.
model PositionAssignment {
  id           String    @id @default(cuid())
  memberId     String
  positionId   String
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  assignedById String
  createdAt    DateTime  @default(now())

  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  position   Position @relation(fields: [positionId], references: [id], onDelete: Restrict)
  assignedBy User     @relation("PositionAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([memberId])
  @@index([positionId])
}

// ─────────────────────────────────────────────────────────────
// Events, registration, attendance, certificates
// ─────────────────────────────────────────────────────────────

model Event {
  id                   String      @id @default(cuid())
  name                 String
  description          String?
  location             String
  startsAt             DateTime
  endsAt               DateTime
  capacity             Int
  registrationDeadline DateTime
  status               EventStatus @default(DRAFT)
  reminderSentAt       DateTime?
  createdById          String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  createdBy          User                @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  registrations      EventRegistration[]
  attendanceSessions AttendanceSession[]
  attendance         Attendance[]
  certificates       Certificate[]
  budgets            Budget[]

  @@index([status, startsAt])
  @@index([startsAt])
}

model EventRegistration {
  id           String             @id @default(cuid())
  eventId      String
  memberId     String
  status       RegistrationStatus @default(REGISTERED)
  registeredAt DateTime           @default(now())
  cancelledAt  DateTime?

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([eventId, memberId])
  @@index([memberId, status])
  @@index([eventId, status])
}

/// A check-in window for an event. `secret` signs the rotating QR codes and
/// never leaves the server.
model AttendanceSession {
  id          String    @id @default(cuid())
  eventId     String
  name        String
  secret      String
  opensAt     DateTime
  closesAt    DateTime
  lateAfter   DateTime
  closedAt    DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  event      Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdBy  User         @relation("AttendanceSessionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  attendance Attendance[]

  @@index([eventId])
}

/// One attendance record per member per event.
model Attendance {
  id           String           @id @default(cuid())
  eventId      String
  memberId     String
  sessionId    String?
  status       AttendanceStatus
  source       AttendanceSource
  checkedInAt  DateTime?
  recordedById String?
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  event      Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  member     Member             @relation(fields: [memberId], references: [id], onDelete: Restrict)
  session    AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  recordedBy User?              @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([eventId, memberId])
  @@index([eventId, status])
  @@index([memberId])
}

/// Recipient and event names are snapshotted at issue time so a verified
/// certificate keeps saying what it said when it was issued.
model Certificate {
  id            String    @id @default(cuid())
  code          String    @unique
  eventId       String
  memberId      String
  recipientName String
  eventName     String
  eventDate     DateTime
  issuedAt      DateTime  @default(now())
  issuedById    String
  revokedAt     DateTime?
  revokedReason String?

  event    Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  issuedBy User   @relation("CertificateIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)

  @@unique([eventId, memberId])
  @@index([memberId])
}

// ─────────────────────────────────────────────────────────────
// Finance
// ─────────────────────────────────────────────────────────────

model Budget {
  id              String       @id @default(cuid())
  name            String
  description     String?
  eventId         String?
  allocatedAmount Decimal      @db.Decimal(12, 2)
  status          BudgetStatus @default(ACTIVE)
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  event     Event?    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdBy User      @relation("BudgetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  expenses  Expense[]

  @@index([eventId])
  @@index([status])
}

/// Expenses are never deleted. Status moves PENDING → APPROVED/REJECTED →
/// (APPROVED only) REIMBURSED, and every move is written to
/// ExpenseStatusChange. A trigger (see migration) blocks deleting
/// non-pending expenses at the database level.
model Expense {
  id             String          @id @default(cuid())
  budgetId       String
  amount         Decimal         @db.Decimal(12, 2)
  category       ExpenseCategory
  description    String
  expenseDate    DateTime        @db.Date
  paidByMemberId String?
  status         ExpenseStatus   @default(PENDING)
  createdById    String
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  reimbursedAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  budget     Budget                @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  paidBy     Member?               @relation("ExpensePaidBy", fields: [paidByMemberId], references: [id], onDelete: Restrict)
  createdBy  User                  @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy User?                 @relation("ExpenseReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  receipts   Receipt[]
  history    ExpenseStatusChange[]

  @@index([budgetId, status])
  @@index([status, expenseDate])
}

/// Append-only (enforced by trigger).
model ExpenseStatusChange {
  id          String         @id @default(cuid())
  expenseId   String
  fromStatus  ExpenseStatus?
  toStatus    ExpenseStatus
  changedById String
  note        String?
  createdAt   DateTime       @default(now())

  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  changedBy User    @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([expenseId, createdAt])
}

model Receipt {
  id           String   @id @default(cuid())
  expenseId    String
  fileKey      String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedAt   DateTime @default(now())

  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([expenseId])
}

// ─────────────────────────────────────────────────────────────
// Documents, announcements, notifications
// ─────────────────────────────────────────────────────────────

model Document {
  id           String             @id @default(cuid())
  title        String
  description  String?
  category     DocumentCategory
  visibility   DocumentVisibility @default(OFFICERS)
  fileKey      String             @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  deletedById  String?

  uploadedBy User  @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  deletedBy  User? @relation("DocumentDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  @@index([category, createdAt])
  @@index([deletedAt])
}

model Announcement {
  id          String             @id @default(cuid())
  title       String
  content     String
  status      AnnouncementStatus @default(DRAFT)
  isPinned    Boolean            @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  authorId    String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────

/// Append-only (enforced by trigger). actorId is null for system actions
/// and for failed logins against unknown emails.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action])
}
